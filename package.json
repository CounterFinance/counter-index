{
  "name": "@opnet-collective/op-index",
  "version": "0.1.5",
  "description": "Indexer framework for OPNET — define schemas, handle events, query indexed chain data",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "op-index": "bin/op-index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "types": "./dist/src/index.d.ts",
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.4",
    "graphql-ws": "^6.0.8",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.58.2",
    "vitest": "^1.6.0",
    "ws": "^8.20.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "graphql": "^16.13.2",
    "postgres": "^3.4.9"
  },
  "peerDependencies": {
    "graphql-ws": "^5.0.0",
    "ws": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "graphql-ws": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  }
}
