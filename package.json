{
  "name": "@opnet-collective/op-index",
  "version": "0.1.12-alpha.3",
  "description": "Indexer framework for OPNET — define schemas, handle events, query indexed chain data",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "op-index": "bin/op-index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "types": "./dist/src/index.d.ts",
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm run lint && npm test",
    "dogfood": "tsx dogfood/run.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "dogfood:evm": "tsx dogfood/evm-anvil.ts",
    "example:evm": "tsx examples/evm-portfolio/demo.ts",
    "dogfood:reorg": "tsx dogfood/evm-reorg.ts",
    "bench": "tsx dogfood/bench.ts",
    "coverage": "vitest run --coverage",
    "dogfood:mainnet": "tsx dogfood/evm-mainnet.ts",
    "dogfood:atomicity": "tsx dogfood/atomicity.ts",
    "test:pg": "bash scripts/pg-test.sh",
    "mutation": "stryker run",
    "bench:batch": "tsx dogfood/bench-batch.ts",
    "dogfood:ops": "tsx dogfood/ops.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/vitest-runner": "^8.7.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^9.39.4",
    "fast-check": "^3.23.2",
    "graphql-ws": "^6.0.8",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.58.2",
    "viem": "^2.21.55",
    "vitest": "^1.6.0",
    "ws": "^8.20.0"
  },
  "dependencies": {
    "bech32": "^2.0.0",
    "better-sqlite3": "^12.0.0",
    "graphql": "^16.13.2",
    "postgres": "^3.4.9"
  },
  "peerDependencies": {
    "graphql-ws": "^6.0.0",
    "viem": "^2.21.0",
    "ws": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "graphql-ws": {
      "optional": true
    },
    "ws": {
      "optional": true
    },
    "viem": {
      "optional": true
    }
  }
}
